<% if @channel.errors.any? %>
  <div class="flash flash--alert">
    <p><b><%= pluralize(@channel.errors.count, "error") %></b> prevented this channel from being saved:</p>
    <ul>
      <% @channel.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @channel do |f| %>
  <div class="field">
    <%= f.label :channel_name, "Channel name *", class: "field__label" %>
    <%= f.text_field :channel_name, placeholder: "e.g. Hasnat's Tech Corner", required: true, class: "field__input" %>
  </div>

  <div class="field">
    <%= f.label :category, "Category *", class: "field__label" %>
    <%= f.select :category, options_for_select(@categories, @channel.category), { prompt: "-- Select a category --" }, { required: true, class: "field__select" } %>
  </div>

  <div class="field">
    <%= f.label :description, class: "field__label" do %>
      Description <span class="field__optional">(optional)</span>
    <% end %>
    <%= f.text_area :description, rows: 4, placeholder: "What is your channel about?", class: "field__textarea" %>
  </div>

  <div class="field">
    <%= f.label :tags_input, "Tags", class: "field__label" %>
    <%= f.text_field :tags_input, placeholder: "tech, coding, rails", class: "field__input" %>
    <p class="field__hint">Separate tags with commas.</p>
  </div>

  <div class="field">
    <%= f.label :avatar, class: "field__label" do %>
      Avatar <span class="field__optional">(optional)</span>
    <% end %>
    <% if @channel.avatar.attached? %>
      <div class="field__preview">
        <%= image_tag @channel.avatar, class: "field__preview-avatar" %>
      </div>
    <% end %>
    <%= f.file_field :avatar, accept: "image/*", class: "field__file" %>
  </div>

  <div class="field">
    <%= f.label :banner, class: "field__label" do %>
      Banner <span class="field__optional">(optional)</span>
    <% end %>
    <% if @channel.banner.attached? %>
      <div class="field__preview">
        <%= image_tag @channel.banner, class: "field__preview-banner" %>
      </div>
    <% end %>
    <%= f.file_field :banner, accept: "image/*", class: "field__file" %>
  </div>

  <%= f.submit (@channel.persisted? ? "Save changes" : "Create channel"), class: "btn btn--primary btn--block" %>
<% end %>
