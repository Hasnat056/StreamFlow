<% if @channel.errors.any? %>
  <div class="form-errors">
    <p><b><%= pluralize(@channel.errors.count, "error") %></b> prevented this channel from being saved:</p>
    <ul>
      <% @channel.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @channel,
      local: true,
      data: {
        controller: "channel-update-form",
        action: "submit->channel-update-form#submit",
        channel_update_form_direct_upload_url_value: rails_direct_uploads_path,
        channel_update_form_submit_url_value: @channel.persisted? ? channel_path(@channel, format: :json) : channels_path(format: :json),
        channel_update_form_http_method_value: @channel.persisted? ? "PATCH" : "POST",
        channel_update_form_redirect_url_value: @channel.persisted? ? channel_path(@channel) : root_path
      } do |f| %>
  <div class="field">
    <%= f.label :channel_name, "Channel name *", class: "field__label" %>
    <%= f.text_field :channel_name, placeholder: "e.g. Hasnat's Tech Corner", required: true, class: "field__input", data: { channel_update_form_target: "channelName" } %>
  </div>

  <div class="field">
    <%= f.label :category, "Category *", class: "field__label" %>
    <%= f.select :category, options_for_select(@categories, @channel.category), { prompt: "-- Select a category --" }, { required: true, class: "field__select", data: { channel_update_form_target: "category" } } %>
  </div>

  <div class="field">
    <%= f.label :description, class: "field__label" do %>
      Description <span class="field__optional">(optional)</span>
    <% end %>
    <%= f.text_area :description, rows: 4, placeholder: "What is your channel about?", class: "field__textarea", data: { channel_update_form_target: "description" } %>
  </div>

  <div class="field">
    <%= f.label :tags_input, "Tags", class: "field__label" %>
    <%= f.text_field :tags_input, placeholder: "tech, coding, rails", class: "field__input", data: { channel_update_form_target: "tagsInput" } %>
    <p class="field__hint">Separate tags with commas.</p>
  </div>

  <div class="field">
    <%= f.label :avatar, class: "field__label" do %>
      Avatar <span class="field__optional">(optional)</span>
    <% end %>
    <% if @channel.channel_avatar_url.present? %>
      <div class="field__preview">
        <%= image_tag @channel.channel_avatar_url, class: "field__preview-avatar" %>
      </div>
    <% end %>
    <%= f.file_field :avatar, accept: "image/*", class: "field__file", data: { channel_update_form_target: "avatar" } %>
  </div>

  <div class="field">
    <%= f.label :banner, class: "field__label" do %>
      Banner <span class="field__optional">(optional)</span>
    <% end %>
    <% if @channel.channel_banner_url.present? %>
      <div class="field__preview">
        <%= image_tag @channel.channel_banner_url, class: "field__preview-banner" %>
      </div>
    <% end %>
    <%= f.file_field :banner, accept: "image/*", class: "field__file", data: { channel_update_form_target: "banner" } %>
  </div>

  <p class="hidden field__warning" data-channel-update-form-target="warning"></p>

  <%= f.submit (@channel.persisted? ? "Save changes" : "Create channel"), class: "btn btn--primary btn--block" %>
<% end %>
