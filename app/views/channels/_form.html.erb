<% if @channel.errors.any? %>
  <div class="form-errors">
    <p><b><%= pluralize(@channel.errors.count, "error") %></b> prevented this channel from being saved:</p>
    <ul>
      <% @channel.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @channel,
      local: true,
      data: {
        controller: "channel-update-form",
        action: "submit->channel-update-form#submit",
        channel_update_form_direct_upload_url_value: rails_direct_uploads_path,
        channel_update_form_submit_url_value: @channel.persisted? ? channel_path(@channel, format: :json) : channels_path(format: :json),
        channel_update_form_http_method_value: @channel.persisted? ? "PATCH" : "POST",
        channel_update_form_redirect_url_value: @channel.persisted? ? channel_path(@channel) : root_path,
        channel_update_form_general_category_id_value: @general_category_id,
        channel_update_form_max_tags_value: Channel::MAX_TAGS
      } do |f| %>
  <div class="field">
    <%= f.label :channel_name, "Channel name *", class: "field__label" %>
    <%= f.text_field :channel_name, placeholder: "e.g. Hasnat's Tech Corner", required: true, class: "field__input", data: { channel_update_form_target: "channelName" } %>
  </div>

  <div class="field">
    <%= f.label :category_id, "Category *", class: "field__label" %>
    <%= f.select :category_id, options_for_select(@categories.map { |c| [ c.name, c.id ] }, @channel.category_id),
          { prompt: "-- Select a category --" },
          { required: true, class: "field__select",
            data: { channel_update_form_target: "category", action: "change->channel-update-form#filterTags" } } %>
  </div>

  <div class="field">
    <%= f.label :description, class: "field__label" do %>
      Description <span class="field__optional">(optional)</span>
    <% end %>
    <%= f.text_area :description, rows: 4, placeholder: "What is your channel about?", class: "field__textarea", data: { channel_update_form_target: "description" } %>
  </div>

  <div class="field">
    <%= f.label :tag_ids, "Tags", class: "field__label" %>
    <p class="field__hint">Pick a category above, then up to <%= Channel::MAX_TAGS %> tags.</p>
    <div class="tag-picker">
      <% @tag_groups.each do |category, tags| %>
        <% next if tags.empty? %>
        <div class="tag-picker__group <%= "hidden" unless category.id == @channel.category_id || category.id == @general_category_id %>"
             data-category-id="<%= category.id %>">
          <p class="tag-picker__group-title"><%= category.is_visible? ? category.name : "General" %></p>
          <% tags.each do |tag| %>
            <label class="tag-option">
              <%= check_box_tag "channel[tag_ids][]", tag.id, @channel.tag_ids.include?(tag.id), id: nil,
                    data: { channel_update_form_target: "tagCheckbox", action: "change->channel-update-form#toggleTag" } %>
              <%= tag.name %>
            </label>
          <% end %>
        </div>
      <% end %>
    </div>
    <p class="hidden field__warning" data-channel-update-form-target="tagsWarning"></p>
  </div>

  <div class="field">
    <%= f.label :avatar, class: "field__label" do %>
      Avatar <span class="field__optional">(optional)</span>
    <% end %>
    <% if @channel.channel_avatar_url.present? %>
      <div class="field__preview">
        <%= image_tag @channel.channel_avatar_url, class: "field__preview-avatar" %>
      </div>
    <% end %>
    <%= f.file_field :avatar, accept: "image/*", class: "field__file", data: { channel_update_form_target: "avatar" } %>
  </div>

  <div class="field">
    <%= f.label :banner, class: "field__label" do %>
      Banner <span class="field__optional">(optional)</span>
    <% end %>
    <% if @channel.channel_banner_url.present? %>
      <div class="field__preview">
        <%= image_tag @channel.channel_banner_url, class: "field__preview-banner" %>
      </div>
    <% end %>
    <%= f.file_field :banner, accept: "image/*", class: "field__file", data: { channel_update_form_target: "banner" } %>
  </div>

  <% if @channel.persisted? %>
    <div class="settings-row">
      <div>
        <p class="settings-row__label">Channel visibility</p>
        <p class="settings-row__hint" data-channel-update-form-target="visibilityHint">
          <%= @channel.visible? ? "Public — anyone can find and watch this channel." : "Private — only you can see this channel." %>
        </p>
      </div>

      <button type="button" class="toggle-switch <%= "toggle-switch--on" if @channel.visible? %>"
            data-channel-update-form-target="visibilityToggle" data-action="click->channel-update-form#toggleVisibility"
            aria-pressed="<%= @channel.visible? %>" aria-label="Toggle channel visibility">
        <span class="toggle-switch__knob"></span>
      </button>
      <%= f.hidden_field :visibility, value: @channel.visibility, data: { channel_update_form_target: "visibilityInput" } %>
    </div>
  <% end %>

  <p class="hidden field__warning" data-channel-update-form-target="warning"></p>

  <%= f.submit (@channel.persisted? ? "Save changes" : "Create channel"), class: "btn btn--primary btn--block" %>
<% end %>
