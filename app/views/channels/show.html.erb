<% content_for :full_bleed do %>
  <% if @channel.channel_banner_url.present? %>
    <div class="channel-banner">
      <%= image_tag @channel.channel_banner_url %>
    </div>
  <% end %>
<% end %>

<div class="channel-header <%= "channel-header--overlap" if @channel.channel_banner_url.present? %>">
  <% if @channel.channel_avatar_url.present? %>
    <%= image_tag @channel.channel_avatar_url, class: "channel-header__avatar-img" %>
  <% else %>
    <div class="channel-header__avatar"><%= @channel.channel_name.first.upcase %></div>
  <% end %>

  <div class="channel-header__body">
    <h1 class="channel-header__name"><%= @channel.channel_name %></h1>
    <span class="badge"><%= @channel.category %></span>
    <span class="badge"><%= pluralize(@channel.subscribers.count, "subscriber") %></span>

    <% if @channel.description.present? %>
      <p class="channel-header__desc"><%= @channel.description %></p>
    <% end %>

    <% if @channel.tags.present? %>
      <div>
        <% @channel.tags.each do |tag| %>
          <span class="tag-pill">#<%= tag %></span>
        <% end %>
      </div>
    <% end %>
  </div>

    <div class="channel-header__actions">
      <% if current_user == @channel.user %>
        <%= link_to "📹 Upload video", new_channel_video_path(@channel), class: "btn btn--primary" %>
        <%= link_to "Edit channel", edit_channel_path(@channel), class: "btn btn--ghost" %>
        <%= link_to "Analytics", channel_analytics_path(@channel), class: "btn btn--ghost" %>
      <% else %>
        <%= render "shared/subscribe_button", channel: @channel %>
      <% end %>
    </div>
</div>

<% if current_user == @channel.user %>
  <section>
    <h2 class="section-title">In process</h2>
    <%= render "channels/in_process_videos", channel: @channel %>
  </section>
<% end %>

<section>
  <h2 class="section-title">Videos</h2>

  <% if @videos.present? %>
    <div class="video-grid">
      <%= render partial: "videos/video_card", collection: @videos, as: :video, locals: { views_by_video: @views_by_video } %>
    </div>
  <% else %>
    <p class="empty-state">No videos yet.</p>
  <% end %>
</section>
