<% likes_count = local_assigns[:likes_count] || comment.comment_likes.size %>
<% liked_by_current_user = local_assigns.key?(:liked_by_current_user) ? local_assigns[:liked_by_current_user] : current_user && current_user.liked_comment?(comment) %>
<div id="comment_<%= comment.id %>" class="comment">
  <% if comment.user.avatar_url.present? %>
    <%= image_tag comment.user.avatar_url, class: "comment__avatar" %>
  <% else %>
    <div class="comment__avatar"><%= comment.user.username.first.upcase %></div>
  <% end %>

  <div class="comment__body">
    <p class="comment__meta">
      <span class="comment__author"><%= comment.user.username %></span>
      · <%= time_ago_in_words(comment.updated_at) %> ago
    </p>
    <p class="comment__text"><%= comment.comment_text %></p>

    <div class="comment__actions">
      <% if liked_by_current_user %>
        <%= button_to channel_video_comment_comment_like_path(video.channel, video, comment), method: :delete, class: "comment__like-btn comment__like-btn--active", aria: { label: "Unlike comment" } do %>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-6.7-4.35-9.33-8.2C.86 10.1 1.1 6.9 3.6 5.1c2.1-1.5 4.9-1.1 6.6.9L12 7.8l1.8-1.8c1.7-2 4.5-2.4 6.6-.9 2.5 1.8 2.74 5 .93 7.7C18.7 16.65 12 21 12 21z"/></svg>
          <span><%= likes_count %></span>
        <% end %>
      <% elsif current_user %>
        <%= button_to channel_video_comment_comment_like_path(video.channel, video, comment), method: :post, class: "comment__like-btn", aria: { label: "Like comment" } do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-6.7-4.35-9.33-8.2C.86 10.1 1.1 6.9 3.6 5.1c2.1-1.5 4.9-1.1 6.6.9L12 7.8l1.8-1.8c1.7-2 4.5-2.4 6.6-.9 2.5 1.8 2.74 5 .93 7.7C18.7 16.65 12 21 12 21z"/></svg>
          <span><%= likes_count %></span>
        <% end %>
      <% else %>
        <span class="comment__like-btn comment__like-btn--static">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-6.7-4.35-9.33-8.2C.86 10.1 1.1 6.9 3.6 5.1c2.1-1.5 4.9-1.1 6.6.9L12 7.8l1.8-1.8c1.7-2 4.5-2.4 6.6-.9 2.5 1.8 2.74 5 .93 7.7C18.7 16.65 12 21 12 21z"/></svg>
          <span><%= likes_count %></span>
        </span>
      <% end %>

      <% if policy(comment).update? %>
        <%= link_to "Edit", edit_channel_video_comment_path(video.channel, video, comment), class: "comment__action-link", data: { turbo_stream: true } %>
        <%= button_to "Delete", channel_video_comment_path(video.channel, video, comment), method: :delete, class: "comment__action-link comment__action-link--danger", form: { data: { turbo_confirm: "Delete this comment?" } } %>
      <% end %>
    </div>
  </div>
</div>
