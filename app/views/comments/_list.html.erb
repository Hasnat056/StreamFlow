<div id="comments_list" class="comments">
  <% liked_by_me_sql = current_user ? Comment.sanitize_sql_array([
       "EXISTS (SELECT 1 FROM comment_likes cl WHERE cl.comment_id = comments.id AND cl.user_id = ?)", current_user.id
     ]) : "false" %>
  <% comments = video.comments
       .left_joins(:comment_likes)
       .select("comments.*, COUNT(comment_likes.id) AS likes_count, #{liked_by_me_sql} AS liked_by_me")
       .group("comments.id")
       .order(created_at: :desc)
       .includes(:user)
       .to_a %>
  <h2 class="comments__heading"><%= pluralize(comments.size, "Comment") %></h2>

  <% if current_user && comments.none? { |comment| comment.user_id == current_user.id } %>
    <%= render "comments/form", video: video %>
  <% end %>

  <% comments.each do |comment| %>
    <%= render "comments/comment", video: video, comment: comment,
          likes_count: comment.likes_count,
          liked_by_current_user: comment.liked_by_me %>
  <% end %>
</div>
