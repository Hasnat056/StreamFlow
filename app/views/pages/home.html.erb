<% unless current_user %>
  <div class="guest-hero">
    <h1 class="guest-hero__headline">Share your videos with the world</h1>
    <p class="guest-hero__sub">Upload, stream, and grow your channel — all in one place.</p>
  </div>
<% end %>

<%= form_with url: root_path, method: :get, class: "search-bar-form" do %>
  <%= text_field_tag :q, @query, placeholder: "Search StreamFlow", class: "search-bar" %>
<% end %>


<section>
  <h2 class="section-title">
    <%= @query.present? ? "Results for “#{@query}”" : "Recently uploaded" %>
  </h2>

  <% if @recent_videos.present? %>
    <div class="video-grid">
      <%= render partial: "videos/video_card", collection: @recent_videos, as: :video, locals: { watch_progress_by_video: @watch_progress_by_video } %>
    </div>
  <% elsif @query.present? %>
    <p class="empty-state">No videos match “<%= @query %>”.</p>
  <% else %>
    <p class="empty-state">No videos yet — be the first to upload!</p>
  <% end %>
</section>
