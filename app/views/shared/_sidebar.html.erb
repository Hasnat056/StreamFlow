<aside class="sidebar">
  <%= link_to root_path, class: "sidebar__logo" do %>
    <svg width="22" height="22" viewBox="0 0 24 24">
      <% (0..5).each do |i| %>
        <g transform="rotate(<%= i * 60 %> 12 12)">
          <path d="M12 12 C 10.3 8.5, 10.3 4.5, 12 2 C 13.7 4.5, 13.7 8.5, 12 12 Z" fill="var(--accent)" opacity="<%= i.even? ? 0.9 : 0.65 %>"/>
        </g>
      <% end %>
    </svg>
    <span class="sidebar__logo-word">Stream<span class="sidebar__logo-word--accent">Flow</span></span>
  <% end %>

  <nav class="sidebar__nav">
    <%= link_to root_path, class: "sidebar__nav-item #{'is-active' if current_page?(root_path)}" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/></svg>
      <span class="sidebar__nav-label">Home</span>
    <% end %>

    <% if current_user %>
      <% channel = current_user.channels.first %>
      <% if channel %>
        <%= link_to channel_path(channel), class: "sidebar__nav-item #{'is-active' if current_page?(channel_path(channel))}" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.2"/><path d="M5 20c1-4 4-6 7-6s6 2 7 6"/></svg>
          <span class="sidebar__nav-label">Your channel</span>
        <% end %>
        <%= link_to new_channel_video_path(channel), class: "sidebar__nav-item #{'is-active' if current_page?(new_channel_video_path(channel))}" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 4v11M7 9l5-5 5 5M5 19h14"/></svg>
          <span class="sidebar__nav-label">Upload</span>
        <% end %>
      <% else %>
        <%= link_to new_channel_path, class: "sidebar__nav-item #{'is-active' if current_page?(new_channel_path)}" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 5v14M5 12h14"/></svg>
          <span class="sidebar__nav-label">Create channel</span>
        <% end %>
      <% end %>
    <% end %>
  </nav>

  <div class="sidebar__footer">
    <button type="button" class="theme-toggle" data-controller="theme" data-action="theme#toggle">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
      <span>Theme</span>
    </button>

    <% if current_user %>
      <div class="profile" data-controller="dropdown" data-action="click@window->dropdown#hide">
        <button type="button" class="profile__btn" data-action="dropdown#toggle">
          <% if current_user.avatar_url.present? %>
            <%= image_tag current_user.avatar_url, class: "profile__avatar-img", alt: current_user.username %>
          <% else %>
            <div class="profile__avatar-fallback"><%= current_user.username.first.upcase %></div>
          <% end %>
          <span class="profile__name sidebar__nav-label"><%= current_user.username %></span>
        </button>

        <div data-dropdown-target="menu" class="profile__menu hidden">
          <div class="profile__menu-head">
            <p class="profile__menu-name"><%= current_user.username %></p>
            <p class="profile__menu-email"><%= current_user.email %></p>
          </div>
          <%= button_to "Log out", logout_path, method: :delete, form_class: "contents", class: "profile__menu-item" %>
        </div>
      </div>
    <% else %>
      <%= button_to "Sign in with Google", "/auth/google_oauth2", data: { turbo: false }, class: "btn btn--primary btn--block" %>
    <% end %>
  </div>
</aside>
