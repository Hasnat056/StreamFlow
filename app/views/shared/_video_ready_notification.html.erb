<div id="video_ready_<%= video.id %>" class="toast" data-controller="toast" data-toast-duration-value="0">
  <div class="toast__icon">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>
  </div>
  <div class="toast__content">
    <p class="toast__title">"<%= video.title %>" is ready</p>
    <%= link_to channel_video_path(video.channel, video), class: "toast__link" do %>
      ▶ Watch now
    <% end %>
  </div>
  <button type="button" class="toast__dismiss" data-action="toast#dismiss">&times;</button>
</div>
