<div class="container upload-page">
  <h2 class="page-title">Upload video to <%= @channel.channel_name %></h2>

  <% if @video.errors.any? %>
    <div class="alert alert--error">
      <h4><%= pluralize(@video.errors.count, "error") %> prohibited this video from being saved:</h4>
      <ul>
        <% @video.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [@channel, @video], local: true,
        data: {
          controller: "video-upload-form",
          action: "submit->video-upload-form#submit",
          video_upload_form_direct_upload_url_value: rails_direct_uploads_path,
          video_upload_form_create_url_value: channel_videos_path(@channel, format: :json),
          video_upload_form_redirect_url_value: root_path
        } do |f| %>
    <div class="form-field">
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title, required: true, class: "form-input", data: { video_upload_form_target: "title" } %>
    </div>

    <div class="form-field">
      <%= f.label :source_file, "Select video", class: "form-label" %>
      <%= f.file_field :source_file, accept: "video/*", required: true, data: { video_upload_form_target: "file" } %>
    </div>

    <p class="form-warning hidden" data-video-upload-form-target="warning"></p>

    <div class="form-actions">
      <%= f.submit "Start Upload", class: "btn btn-primary" %>
    </div>
  <% end %>

  <p class="upload-hint">Your video uploads in the background — feel free to navigate away once you click Start Upload.</p>
</div>
