<div class="form-card">
  <h1 class="form-card__title">Upload video to <%= @channel.channel_name %></h1>

  <% if @video.errors.any? %>
    <div class="form-errors">
      <p><b><%= pluralize(@video.errors.count, "error") %></b> prohibited this video from being saved:</p>
      <ul>
        <% @video.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [@channel, @video], local: true,
        data: {
          controller: "video-upload-form",
          action: "submit->video-upload-form#submit",
          video_upload_form_direct_upload_url_value: rails_direct_uploads_path,
          video_upload_form_create_url_value: channel_videos_path(@channel, format: :json),
          video_upload_form_redirect_url_value: root_path
        } do |f| %>
    <div class="field">
      <%= f.label :title, class: "field__label" %>
      <%= f.text_field :title, required: true, class: "field__input", data: { video_upload_form_target: "title" } %>
    </div>

    <div class="field">
      <%= f.label :source_file, "Select video", class: "field__label" %>
      <%= f.file_field :source_file, accept: "video/*", required: true, class: "field__file", data: { video_upload_form_target: "file" } %>
    </div>

    <p class="hidden field__warning" data-video-upload-form-target="warning"></p>

    <%= f.submit "Start Upload", class: "btn btn--primary btn--block" %>
  <% end %>

  <p class="form-card__hint">Your video uploads in the background — feel free to navigate away once you click Start Upload.</p>
</div>
