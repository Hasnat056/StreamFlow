<div class="watch-layout">
  <div>
    <div class="player-wrap">
      <video
        controls
        data-controller="hls-player"
        data-hls-player-src-value="<%= @video.active_playlist.master_file_url %>"
        data-hls-player-view-url-value="<%= channel_video_video_view_path(@channel, @video) %>"
      ></video>
    </div>

    <h1 class="video-title"><%= @video.title %></h1>
    <p class="video-meta"><span class="video-meta__stat"><%= pluralize(@video.video_views.size, "view") %></span> · <%= time_ago_in_words(@video.created_at) %> ago</p>
    <div class="video-channel-byline">
      <% if @channel.avatar.attached? %>
        <%= image_tag @channel.avatar, class: "video-card__avatar" %>
      <% else %>
        <div class="video-card__avatar"><%= @channel.channel_name.first.upcase %></div>
      <% end %>
      <%= link_to @channel.channel_name, channel_path(@channel), class: "video-channel-link" %>
      <%= render "shared/like_button", video: @video %>
      <div class="video-channel-byline__spacer">
        <%= render "shared/subscribe_button", channel: @channel %>
      </div>
    </div>
  </div>

  <div>
    <h2 class="watch-rail__heading">More from this channel</h2>
    <% if @related_videos.present? %>
      <%= render partial: "videos/video_card_compact", collection: @related_videos, as: :video %>
    <% else %>
      <p class="watch-rail__empty">No other videos yet.</p>
    <% end %>
  </div>
</div>

<%= link_to "← Back to home", root_path, class: "back-link" %>
