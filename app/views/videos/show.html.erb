<div class="watch-layout">
  <div>
    <div class="player-wrap">
      <video
        controls
        data-controller="hls-player"
        data-hls-player-src-value="<%= @video.playlist_master_file_url %>"
        data-hls-player-view-url-value="<%= channel_video_video_view_path(@channel, @video) %>"
        <% if current_user %>
          <% resumable = @video.wp_last_timestamp_sec.present? && (@video.wp_last_timestamp_sec.to_f / @video.duration_sec) < WatchProgress::RESUMABLE_THRESHOLD %>
          data-hls-player-watch-progress-url-value="<%= channel_video_watch_progress_path(@channel, @video) %>"
          data-hls-player-resume-at-value="<%= resumable ? @video.wp_last_timestamp_sec : 0 %>"
        <% end %>
      ></video>
    </div>

    <h1 class="video-title"><%= @video.title %></h1>
    <p class="video-meta"><span class="video-meta__stat"><%= pluralize(@video.views_count, "view") %></span> · <%= time_ago_in_words(@video.created_at) %> ago</p>
    <div class="video-channel-byline">
      <% if @channel.channel_avatar_url.present? %>
        <%= image_tag @channel.channel_avatar_url, class: "video-card__avatar" %>
      <% else %>
        <div class="video-card__avatar"><%= @channel.channel_name.first.upcase %></div>
      <% end %>
      <%= link_to @channel.channel_name, channel_path(@channel), class: "video-channel-link" %>
      <%= render "shared/like_button", video: @video %>
      <div class="video-channel-byline__spacer">
        <%= render "shared/subscribe_button", channel: @channel %>
      </div>
    </div>

    <%= render "comments/list", video: @video %>
  </div>

  <div>
    <h2 class="watch-rail__heading">More from this channel</h2>
    <% if @related_videos.present? %>
      <%= render partial: "videos/video_card_compact", collection: @related_videos, as: :video, locals: { channel: @channel } %>
    <% else %>
      <p class="watch-rail__empty">No other videos yet.</p>
    <% end %>
  </div>
</div>

<%= link_to "← Back to home", root_path, class: "back-link" %>
