# Copy to .env (gitignored) and fill in with real values before running
# docker compose up. .env is auto-loaded by docker compose.

# Contents of config/master.key - required to decrypt Rails credentials
# (including the R2 and existing database credentials) inside the containers.
RAILS_MASTER_KEY=

# Must match config/database.yml's production credentials
# (Rails.application.credentials.dig(:database, :DB_USERNAME/:DB_PASSWORD)) -
# the db container is seeded with these on first boot, and Rails connects
# using the same values from its encrypted credentials.
POSTGRES_USER=
POSTGRES_PASSWORD=
